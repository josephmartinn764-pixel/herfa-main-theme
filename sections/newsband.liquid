<section class="newsband">
  <div class="newsband-inner">
    <div>
      <h3 class="serif">Join the HERFA circle</h3>
      <p class="sub">Be the first to know about new collections, exclusive offers, and more.</p>
      <form method="post" action="/contact#newsletter">
        <input type="email" name="contact[email]" placeholder="Enter your email">
        <button type="submit">→</button>
      </form>
    </div>
    <div class="benefit">
      <svg viewBox="0 0 40 40" fill="none" stroke="#F6EEE3" stroke-width="1.4"><circle cx="20" cy="20" r="15"/><path d="M14 20 L18 24 L27 15"/></svg>
      <div><h4>Exclusive access</h4><p>Early access to new collections</p></div>
    </div>
    <div class="benefit">
      <svg viewBox="0 0 40 40" fill="none" stroke="#F6EEE3" stroke-width="1.4"><rect x="7" y="12" width="26" height="18" rx="2"/><path d="M7 16 L20 24 L33 16"/></svg>
      <div><h4>Special offers</h4><p>Members-only privileges</p></div>
    </div>
    <div class="benefit">
      <svg viewBox="0 0 40 40" fill="none" stroke="#F6EEE3" stroke-width="1.4"><path d="M20 6 L20 34 M6 20 L34 20"/><circle cx="20" cy="20" r="15"/></svg>
      <div><h4>Style inspo</h4><p>Tips and looks, just for you</p></div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Newsletter band","settings":[],"presets":[{"name":"Newsletter band"}]}
{% endschema %}
