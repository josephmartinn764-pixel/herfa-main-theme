<section class="product-section">
  <div class="wrap">
    <div class="pdp">
      <div class="thumbs">
        {% for image in product.images %}
          <div class="thumb" style="background-image:url({{ image | img_url: '1024x' }})"></div>
        {% endfor %}
      </div>
      <div class="main-img">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: '1024x' }}" alt="{{ product.title }}">
        {% endif %}
      </div>
      <div class="info">
        <h1 class="serif">{{ product.title }}</h1>
        <div class="price">{{ product.price | money }}</div>
        <div class="desc">{{ product.description }}</div>

        {% if product.options.size > 0 %}
          <div class="opt-label">Options</div>
          <form method="post" action="/cart/add">
            <select name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
              {% endfor %}
            </select>
            <button type="submit" class="btn-bag">Add to bag</button>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Product section","settings":[],"presets":[{"name":"Product"}]}
{% endschema %}
