<section class="hero">
  <div class="hero-copy">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="btn btn-solid">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
  <div class="hero-img"></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted with purpose, worn with grace." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Timeless abayas that flow with you, designed with heritage, crafted with care." },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Discover collections →" }
  ],
  "blocks": [],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
