<header id="site-header">
  <div class="nav">
    <div class="logo-block">
      {% render 'logo' %}
    </div>

    <nav id="site-nav" class="nav-center" role="navigation" aria-label="Main menu">
      <ul>
        <li><a href="/collections/all">Shop</a></li>
        <li><a href="/collections">Collections</a></li>
        <li><a href="/pages/our-story">Our story</a></li>
        <li><a href="/pages/fabrics">Fabrics</a></li>
        <li><a href="/blogs/news">Journal</a></li>
      </ul>
    </nav>

    <div class="nav-icons">
      <a href="/search" class="icon-link" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6" stroke="#211A13" stroke-width="1.4"/><path d="M21 21l-4.3-4.3" stroke="#211A13" stroke-width="1.4" stroke-linecap="round"/></svg>
      </a>

      <a href="/account" class="icon-link" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3" stroke="#211A13" stroke-width="1.4"/><path d="M6 20c1.6-2.6 4.4-4 6-4s4.4 1.4 6 4" stroke="#211A13" stroke-width="1.4" stroke-linecap="round"/></svg>
      </a>

      <a href="/cart" class="icon-link cart-link" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6h15l-1.6 9.3A2 2 0 0 1 17.4 18H8.6a2 2 0 0 1-1.9-1.6L5 4H3" stroke="#211A13" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="cart-count">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      </a>

      <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">☰</button>
    </div>
  </div>
</header>

{% schema %}
{"name":"Header","settings":[],"presets":[{"name":"Header"}]}
{% endschema %}
