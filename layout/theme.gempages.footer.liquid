<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{% if template == 'index' %}{{ shop.name }}{% else %}{{ page_title }} — {{ shop.name }}{% endif %}</title>

    <!-- Google Fonts from original template -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:wght@300;400;500;600;700&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet">

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <div style="display:none"> {% section 'header' %} </div>

    <main role="main">{{ content_for_layout }}</main>

    {% section 'footer' %}

    {{ content_for_footer }}
    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
