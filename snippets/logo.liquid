{% comment %} Logo snippet: shows theme logo if set, otherwise uses inline arched frame SVG and inline wordmark. Arabic and Latin wordmark sit inline. {% endcomment %}
{% if settings.logo != blank %}
  <a href="{{ shop.url }}" class="logo-block" aria-label="{{ shop.name }}">
    <img src="{{ settings.logo | image_url: '400x' }}" alt="{{ shop.name }} logo" class="logo-mark-svg" />
    <div class="logo-text">
      <span class="ar arabic">حرفة</span>
      <span class="en">HERFA</span>
    </div>
  </a>
{% elsif 'herfa-logo.svg' | asset_url %}
  <a href="{{ shop.url }}" class="logo-block" aria-label="{{ shop.name }}">
    <img src="{{ 'herfa-logo.svg' | asset_url }}" alt="{{ shop.name }} logo" class="logo-mark-svg" />
    <div class="logo-text">
      <span class="ar arabic">حرفة</span>
      <span class="en">HERFA</span>
    </div>
  </a>
{% else %}
  <!-- Inline arched-frame fallback SVG + inline wordmark -->
  <a href="{{ shop.url }}" class="logo-block" aria-label="{{ shop.name }}">
    <svg class="logo-mark-svg" width="64" height="80" viewBox="0 0 120 150" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <!-- arch frame -->
      <path d="M60 6 C86 6 106 26 106 52 L106 120 C106 134 94 146 80 146 L40 146 C26 146 14 134 14 120 L14 52 C14 26 34 6 60 6 Z" stroke="#B3502C" fill="none" stroke-width="2"/>
      <!-- internal motif (stylized) -->
      <path d="M40 70 C50 50 70 44 80 70 C90 100 62 120 60 130" stroke="#B3502C" fill="none" stroke-width="1.6" stroke-linecap="round"/>
      <!-- star above -->
      <circle cx="60" cy="22" r="2.6" fill="#B3502C" />
    </svg>
    <div class="logo-text">
      <span class="ar arabic">حرفة</span>
      <span class="en">HERFA</span>
    </div>
  </a>
{% endif %}
