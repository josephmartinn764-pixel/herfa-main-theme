{% if settings.logo != blank %}
<a href="{{ shop.url }}" class="logo-block" aria-label="{{ shop.name }}">
  <img src="{{ settings.logo | image_url: '300x' }}" alt="{{ shop.name }} logo" class="logo-mark-svg" />
  <div class="logo-text">
    <span class="ar arabic">حرفة</span>
    <span class="en">{{ shop.name }}</span>
  </div>
</a>
{% else %}
<a href="{{ shop.url }}" class="logo-block" aria-label="{{ shop.name }}">
  <svg class="logo-mark-svg" viewBox="0 0 200 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true" focusable="false">
    <g fill="none" stroke="#B3502C" stroke-width="2">
      <rect x="8" y="8" width="184" height="224" rx="8"/>
    </g>
    <g transform="translate(20,18)" stroke="#B3502C" stroke-width="1.4" fill="none">
      <path d="M60 20 C40 20 30 40 30 60 C30 82 40 100 60 110 C80 100 90 82 90 60 C90 40 80 20 60 20 Z"/>
    </g>
  </svg>
  <div class="logo-text">
    <span class="ar arabic">حرفة</span>
    <span class="en">{{ shop.name }}</span>
  </div>
</a>
{% endif %}
